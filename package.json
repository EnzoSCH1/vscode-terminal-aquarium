{
  "name": "vscode-terminal-aquarium",
  "displayName": "vscode-terminal Pixel Aquarium",
  "description": "An interactive 2D pixel-art aquarium—with fish, plants, rocks, and a technical substrate—right in the background of the VS Code terminal.",
  "version": "1.1.0",
  "publisher": "EnzoSCH1",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnzoSCH1/vscode-terminal-aquarium.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Themes", "Other"],
  "keywords": ["aquarium", "terminal", "pixel art", "background", "aquascape", "fish"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terminalAquarium.install",
        "title": "Terminal Aquarium: Enable / Update Background"
      },
      {
        "command": "terminalAquarium.uninstall",
        "title": "Terminal Aquarium: Disable Background"
      }
    ]
  }
}